---
interface Props {
  title: string;
  description: string;
  techStack: string[];
  slug: string;
}

const { title, description, techStack, slug } = Astro.props;
---
<a
  href={`/projects/${slug}`}
  class="block border border-neutral-800 rounded-xl p-6 hover:border-neutral-600 transition-colors"
>
  <h3 class="text-lg font-semibold mb-2">{title}</h3>
  <p class="text-neutral-400 text-sm mb-4">{description}</p>
  <div class="flex flex-wrap gap-2">
    {techStack.map((tech) => (
      <span class="text-xs px-2 py-1 rounded-full bg-neutral-800 text-neutral-300">
        {tech}
      </span>
    ))}
  </div>
</a>
