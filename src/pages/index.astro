---
import TechStack from '../components/TechStack.astro';
import ChatWidget from "../components/ChatWidget.jsx";
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Keys = project file names in src/content/projects/ (without .md)
// Values = image paths inside the public/ folder
const images: Record<string, string> = {
  'car-project': '/car-project.png',
  'ml-flyrank': '/ml-flyrank.png',
  'ml-models': '/ml-models.png',
};
---
<BaseLayout title="Home">
  <div class="mb-8">
   <div class="mb-8 flex justify-end">
    <input
      id="project-search"
      type="text"
      placeholder="Search projects..."
      class="w-full sm:w-72 bg-neutral-900 border border-neutral-800 rounded-lg px-4 py-2 text-sm text-neutral-200 placeholder-neutral-500 focus:outline-none focus:border-neutral-600"
    />
  </div>

  <section class="mb-16 flex flex-col sm:flex-row items-start sm:items-center gap-6">
    <img
      src="/prof-pic.png"
      alt="Siseko Sodlaka"
      class="w-28 h-28 rounded-full object-cover border border-neutral-800"
    />
    <div>
      <h1 class="text-4xl font-bold tracking-tight mb-4">Hi, I'm Siseko Sodlaka.</h1>
      <p class="text-neutral-400 text-lg max-w-xl">
        Software developer working on data-driven projects, from analysis and
        machine learning to full-stack apps. Here's a look at some of my work.
      </p>
    </div>
  </section>

  <section>
    <h2 class="text-xl font-semibold mb-6">Featured work</h2>
    <div id="project-grid" class="grid gap-6 sm:grid-cols-2">
      {featured.map((project) => {
        const key = project.slug ?? project.id.replace(/\.mdx?$/, '');
        const image = images[key];
        return (
          <div
            class="project-item"
            data-title={project.data.title.toLowerCase()}
            data-tech={project.data.techStack.join(' ').toLowerCase()}
          >
            {image ? (
              <div class="tilt-wrap">
                <a
                  href={`/projects/${key}`}
                  aria-label={project.data.title}
                  class="tilt-card block overflow-hidden rounded-xl border border-neutral-800"
                >
                  <img
                    src={image}
                    alt={project.data.title}
                    class="w-full h-auto block"
                    loading="lazy"
                  />
                </a>
              </div>
            ) : (
              <ProjectCard
                title={project.data.title}
                description={project.data.description}
                techStack={project.data.techStack}
                slug={project.slug}
              />
            )}
          </div>
        );
      })}
    </div>
    <p id="no-results" class="text-neutral-500 text-sm hidden">No projects match your search.</p>
  </section>

  <ChatWidget client:only="react" />
  </div>
</BaseLayout>

<style>
  .tilt-wrap {
    perspective: 1000px;
  }

  .tilt-card {
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.2s ease-out, box-shadow 0.3s ease;
    will-change: transform;
  }

  .tilt-card:hover {
    box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.8);
    border-color: rgb(115 115 115);
  }

  /* Soft light that follows the mouse */
  .tilt-card::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    background: radial-gradient(
      circle at var(--glare-x, 50%) var(--glare-y, 50%),
      rgba(255, 255, 255, 0.25),
      transparent 55%
    );
  }

  .tilt-card:hover::after {
    opacity: 1;
  }
</style>

<script>
  const input = document.getElementById('project-search') as HTMLInputElement;
  const items = document.querySelectorAll<HTMLElement>('.project-item');
  const noResults = document.getElementById('no-results');

  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let visibleCount = 0;

    items.forEach((item) => {
      const matches =
        item.dataset.title?.includes(query) || item.dataset.tech?.includes(query);
      item.style.display = matches ? '' : 'none';
      if (matches) visibleCount++;
    });

    noResults?.classList.toggle('hidden', visibleCount !== 0);
  });

  // 3D tilt on project pictures
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const MAX_TILT = 14; // degrees

  if (!reduceMotion) {
    document.querySelectorAll<HTMLElement>('.tilt-card').forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width;
        const y = (e.clientY - rect.top) / rect.height;
        const rotateY = (x - 0.5) * 2 * MAX_TILT;
        const rotateX = (0.5 - y) * 2 * MAX_TILT;

        card.style.transform =
          `rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.04, 1.04, 1.04)`;
        card.style.setProperty('--glare-x', `${x * 100}%`);
        card.style.setProperty('--glare-y', `${y * 100}%`);
      });

      card.addEventListener('mouseleave', () => {
        card.style.transform = '';
      });
    });
  }
</script>