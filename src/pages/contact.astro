---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact">
  <h1 class="text-3xl font-bold tracking-tight mb-6">Contact</h1>
  <p class="text-neutral-400 mb-8 max-w-xl">
    Want to get in touch? Reach out through any of the links below.
  </p>
   <ul class="space-y-3 text-neutral-300">
    <li>
      Email: <a href="mailto:you@example.com" class="underline hover:text-white">you@example.com</a>
    </li>
    <li>
      GitHub: <a href="https://github.com/Siseko001" class="underline hover:text-white">github.com/Siseko001</a>
    </li>
    <li>
      LinkedIn: <a href="https://www.linkedin.com/in/siseko-sodlaka-a55541196" class="underline hover:text-white">linkedin.com/in/siseko-sodlaka</a>
    </li>
  </ul>
  <a
    href="/resume.pdf"
    download
    class="inline-block mt-8 px-8 py-4 rounded-lg bg-white text-neutral-900 text-base font-semibold hover:bg-neutral-200 transition-colors"
  >
    Download Resume
  </a>

  <section class="mt-16 max-w-xl">
    <h2 class="text-2xl font-bold tracking-tight mb-2">Let's Connect</h2>
    <p class="text-neutral-400 mb-6">
      Have a project in mind or just want to say hi? Send me a message.
    </p>

    <form
      name="lets-connect"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/thank-you"
      class="flex flex-col gap-4"
    >
      <input type="hidden" name="form-name" value="lets-connect" />
      <p class="hidden">
        <label>
          Don't fill this out if you're human: <input name="bot-field" />
        </label>
      </p>

      <div class="flex flex-col gap-1.5">
        <label for="name" class="text-sm font-semibold text-neutral-300">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="rounded-lg border border-neutral-700 bg-neutral-900 px-3 py-2 text-neutral-100 placeholder-neutral-500 focus:outline-none focus:ring-2 focus:ring-white/40"
        />
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="email" class="text-sm font-semibold text-neutral-300">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="rounded-lg border border-neutral-700 bg-neutral-900 px-3 py-2 text-neutral-100 placeholder-neutral-500 focus:outline-none focus:ring-2 focus:ring-white/40"
        />
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="message" class="text-sm font-semibold text-neutral-300">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="rounded-lg border border-neutral-700 bg-neutral-900 px-3 py-2 text-neutral-100 placeholder-neutral-500 focus:outline-none focus:ring-2 focus:ring-white/40"
        ></textarea>
      </div>

      <button
        type="submit"
        class="mt-2 inline-block px-8 py-4 rounded-lg bg-white text-neutral-900 text-base font-semibold hover:bg-neutral-200 transition-colors"
      >
        Send Message
      </button>
    </form>
  </section>
</BaseLayout>
