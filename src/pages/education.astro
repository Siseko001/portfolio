---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Education">
  <h1 class="text-3xl font-bold tracking-tight mb-6">Education</h1>
  <div class="space-y-6 text-neutral-400 max-w-xl">
    <div>
      <h2 class="text-lg font-semibold text-neutral-200">FlyRank AI Internship</h2>
      <p class="text-sm text-neutral-500 mb-1">Self-paced remote program</p>
      <p>Applied AI/ML track and General AI Fluency track.</p>
    </div>
    <div>
      <h2 class="text-lg font-semibold text-neutral-200">Gen AI, Artificial Intelligence</h2>
      <p class="text-sm text-neutral-500 mb-1">Regenesys Education · Grade: Advanced Professional</p>
      <p>Skills: Data Manipulation, Data Visualization, and more.</p>
    </div>
    <div>
      <h2 class="text-lg font-semibold text-neutral-200">Diploma in Information Technology</h2>
      <p class="text-sm text-neutral-500 mb-1">Cape Peninsula University of Technology</p>
      <p>Skills: C++, SQL.</p>
    </div>
    <div>
      <h2 class="text-lg font-semibold text-neutral-200">Certificate in MySQL for Database Administrators</h2>
      <p class="text-sm text-neutral-500 mb-1">Torque IT</p>
      <p>Skills: SQL.</p>
    </div>
  </div>
</BaseLayout>