---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About">
  <h1 class="text-3xl font-bold tracking-tight mb-6">About</h1>
  <p class="text-neutral-400 leading-relaxed max-w-xl mb-4">
    I'm a software developer interested in data analysis, machine learning, and
    building things end to end. Replace this paragraph with your own background,
    what you're currently learning, and what you're looking for.
  </p>
  <p class="text-neutral-400 leading-relaxed max-w-xl">
    Add details on your skills, tools you use regularly, and any relevant
    experience or education here.
  </p>
</BaseLayout>
